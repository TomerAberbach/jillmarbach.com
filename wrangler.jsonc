{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jillmarbach",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
  // The jillmarbach.com custom domain is attached in the Cloudflare dashboard.
  "workers_dev": false,
  "preview_urls": false,
}
